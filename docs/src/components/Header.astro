---
// Single-row desktop header: [Logo] [Topic tabs + Viewer + Plugins + More] ... [Search] [GitHub] [Theme].
// On narrow screens (< 64rem) the topic tabs wrap onto a compact scrolling row underneath.
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { MAIN, MORE, PLUGINS } from '../data/nav.mjs';

const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
const pick = (labels: string[]) =>
  labels.map((l) => topics.find((t) => t.label === l)).filter((t) => t !== undefined);
const main = pick(MAIN);
const plugins = pick(PLUGINS);
const more = pick(MORE);
const anyCurrent = (list: typeof topics) => list.some((t) => t.isCurrent);
const viewer = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/viewer/`;
---

<div class="header-row">
  <div class="title-wrap">
    <SiteTitle {...Astro.props} />
  </div>

  <nav class="tabs wide" aria-label="Topics">
    {
      main.map((t) => (
        <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
          {t.label}
        </a>
      ))
    }
    <a class="app" href={viewer} title="dsp-kitchen in your browser: open a recording from your disk">Viewer</a>
    {
      [
        { label: 'Plugins', list: plugins },
        { label: 'More', list: more },
      ].map(({ label, list }) => (
        <details class="menu" data-current={anyCurrent(list) ? '' : undefined}>
          <summary>{label}</summary>
          <ul>
            {list.map((t) => (
              <li>
                <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </nav>

  <div class="right-group">
    <div class="search-wrap">
      <Search {...Astro.props} />
    </div>
    <div class="sl-hidden md:sl-flex social-theme">
      <SocialIcons {...Astro.props} />
      <ThemeSelect {...Astro.props} />
    </div>
  </div>
</div>

<nav class="tabs narrow" aria-label="Topics">
  {
    main.map((t) => (
      <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
        {t.label}
      </a>
    ))
  }
  <a class="app" href={viewer}>Viewer</a>
  {
    [...plugins, ...more].map((t) => (
      <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
        {t.label}
      </a>
    ))
  }
</nav>

<script>
  // One menu open at a time; a click elsewhere or Escape closes it.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.tabs .menu')];
  for (const m of menus) {
    m.addEventListener('toggle', () => {
      if (m.open) menus.filter((o) => o !== m).forEach((o) => (o.open = false));
    });
  }
  document.addEventListener('click', (e) => {
    for (const m of menus) if (!m.contains(e.target as Node)) m.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const m of menus) {
      if (m.open) {
        m.open = false;
        m.querySelector('summary')?.focus();
      }
    }
  });
</script>

<style>
  .header-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: calc(var(--dk-nav-base) - 2 * var(--sl-nav-pad-y));
    width: 100%;
  }

  .title-wrap {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .right-group {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 0 1 auto;
  }

  .search-wrap {
    width: min(14rem, 32vw);
  }
  .search-wrap :global(button[data-open-modal]) {
    width: 100%;
    max-width: 14rem;
  }

  .social-theme {
    align-items: center;
    gap: 0.75rem;
  }
  .social-theme::before {
    content: '';
    width: 1px;
    height: 1.25rem;
    background: var(--sl-color-gray-5);
  }

  .tabs {
    display: flex;
    align-items: stretch;
    gap: 0.15rem;
  }
  .tabs.wide {
    display: none;
    height: var(--dk-nav-base);
    align-items: stretch;
  }
  .tabs.narrow {
    height: calc(var(--dk-tabs) + var(--sl-nav-pad-y));
    margin-block-end: calc(-1 * var(--sl-nav-pad-y));
    padding-block-start: var(--sl-nav-pad-y);
    margin-inline: -0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs.narrow::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 64rem) {
    .tabs.wide {
      display: flex;
    }
    .tabs.narrow {
      display: none;
    }
  }

  .tabs a,
  .tabs summary {
    display: flex;
    align-items: center;
    padding-inline: 0.65rem;
    border-block-end: 2px solid transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .tabs a:hover,
  .tabs summary:hover {
    color: var(--sl-color-white);
  }
  .tabs > a[aria-current='page'],
  .tabs .menu[data-current] > summary {
    color: var(--sl-color-white);
    border-block-end-color: var(--sl-color-accent);
  }

  /* The app, not a topic: the accent colour and a small play mark. */
  .tabs a.app {
    gap: 0.35rem;
    color: var(--sl-color-text-accent);
  }
  .tabs a.app::before {
    content: '';
    width: 0;
    height: 0;
    border-block: 0.3rem solid transparent;
    border-inline-start: 0.45rem solid currentColor;
  }
  .tabs a.app:hover {
    color: var(--sl-color-white);
  }

  .menu {
    position: relative;
    display: flex;
  }
  .menu summary {
    list-style: none;
    gap: 0.35rem;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  /* A small caret that turns when the menu opens. */
  .menu summary::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
  }
  .menu[open] summary::after {
    transform: translateY(0.1rem) rotate(-135deg);
  }
  .menu ul {
    position: absolute;
    inset-block-start: calc(100% + 0.25rem);
    inset-inline-start: 0;
    z-index: 20;
    min-width: 12rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  .menu li a {
    padding: 0.4rem 0.65rem;
    border: 0;
    border-radius: 0.3rem;
  }
  .menu li a:hover {
    background: var(--sl-color-gray-6);
  }
  .menu li a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }
</style>
