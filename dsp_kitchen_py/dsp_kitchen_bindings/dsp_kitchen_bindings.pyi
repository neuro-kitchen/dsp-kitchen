def correct_drift_kriging(data: typing.Any, probe: ProbeLayout, time_bin_centers_sec: typing.Sequence[builtins.float], drift_um: typing.Sequence[builtins.float], *, fs: builtins.float, sigma_um: builtins.float, radius_um: builtins.float, start_sample: builtins.int = 0) -> numpy.typing.NDArray[numpy.float32]:
    r"""
