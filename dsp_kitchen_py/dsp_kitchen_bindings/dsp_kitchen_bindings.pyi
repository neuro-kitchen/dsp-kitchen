        Parameters
        ----------
        start_sample : int, default 0
        end_sample : int, optional
            Exclusive; default: one second after `start_sample`.
        channels : list of int, optional
            Channel indices; default: all.
        
        Returns
        -------
        numpy.ndarray
            `[channels, samples]` float32, in each channel's unit.
        """
    def read_window(self, start_sec: builtins.float, duration_sec: builtins.float, channels: typing.Optional[typing.Sequence[builtins.int]] = None) -> numpy.typing.NDArray[numpy.float32]:
        r"""
