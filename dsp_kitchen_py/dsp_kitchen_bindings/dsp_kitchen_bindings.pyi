def estimate_channel_delays(batches: typing.Sequence[typing.Any], *, pad: builtins.int, max_lag: builtins.int, runtime: typing.Optional[builtins.str] = None) -> tuple[builtins.list[builtins.int], builtins.int]:
    r"""
    EMUsort's channel delays from preprocessed batches, on the device: the rectified, normalised
    channels are cross-correlated within ±`max_lag`, the reference channel is the one best correlated
    with all others, and each channel's delay is its best lag against it. Every batch is uploaded once
    and the correlations read back once.
    
    Parameters
    ----------
    batches : list of numpy.ndarray
        Each `[channels, samples]`, padded by `pad` samples on each side.
    pad : int
        Padding of each batch, samples (the correlation uses `[pad, samples − pad)`).
    max_lag : int
        Largest delay searched, samples (EMUsort: 2 ms).
    runtime : str, optional
        Compute runtime (`"wgpu"`, `"cuda"`, `"cpu"`, …); default: the current one.
    
    Returns
    -------
    tuple
        `(delays, reference_channel)`: `delays` (list of int, samples, one per channel).
    """

def estimate_noise(data: typing.Any, method: builtins.str = 'mad', *, clip_sigma: typing.Optional[builtins.float] = None, iterations: typing.Optional[builtins.int] = None) -> numpy.typing.NDArray[numpy.float32]:
    r"""
    Noise σ of every channel.
    
    Parameters
    ----------
    data : numpy.ndarray
        `[channels, samples]`, converted to float32.
    method : {"mad", "rms", "trimmed"}, default "mad"
        `"mad"`: median |x| / 0.6745 (robust to spikes); `"rms"`: root mean square; `"trimmed"`: σ
        re-estimated without samples beyond `clip_sigma · σ`, `iterations` times.
    clip_sigma : float, optional
        `"trimmed"` only (required there).
    iterations : int, optional
        `"trimmed"` only (required there).
    
    Returns
    -------
    numpy.ndarray
        `[channels]` float32, in the data's unit.
    """

def estimate_nonrigid_drift(spike_samples: typing.Sequence[builtins.int], spike_depths_um: typing.Sequence[builtins.float], *, fs: builtins.float, num_depth_blocks: builtins.int, time_bin_sec: builtins.float, depth_bin_um: builtins.float, max_drift_um: builtins.float, spike_amplitudes: typing.Optional[typing.Sequence[builtins.float]] = None, depth_range_um: typing.Optional[tuple[builtins.float, builtins.float]] = None, duration_sec: typing.Optional[builtins.float] = None) -> dict:
    r"""
    Depth-dependent drift: rigid drift estimated separately in `num_depth_blocks` depth blocks.
    
