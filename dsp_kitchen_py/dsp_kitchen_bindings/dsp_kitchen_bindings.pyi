        Parameters
        ----------
        start_sec : float
            Start, s of acquisition time (`start_time_sec` is the time of sample 0).
        duration_sec : float
            Length, s.
        channels : list of int, optional
            Channel indices; default: all.
        
        Returns
        -------
        numpy.ndarray
            `[channels, samples]` float32, in each channel's unit.
        """
    def __repr__(self) -> builtins.str: ...

