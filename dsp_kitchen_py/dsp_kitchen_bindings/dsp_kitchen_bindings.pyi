    def path(self) -> builtins.str:
        r"""
        File or folder the recording was opened from.
        """
    @property
    def name(self) -> builtins.str:
        r"""
        Name of the recording (file name, and source when not the main one).
        """
    @property
    def channels(self) -> builtins.int:
        r"""
        Number of channels.
        """
    @property
    def samples(self) -> builtins.int:
        r"""
        Number of samples per channel.
        """
    @property
    def sample_rate(self) -> builtins.float:
        r"""
        Sampling rate, Hz.
        """
    @property
    def duration_sec(self) -> builtins.float:
        r"""
        Duration, s (`samples / sample_rate`).
        """
    @property
    def start_time_sec(self) -> builtins.float:
        r"""
        Time of sample 0 from the acquisition start (s).
        """
    @property
    def shape(self) -> tuple[builtins.int, builtins.int]:
        r"""
        `(channels, samples)`.
        """
    @property
    def channel_names(self) -> builtins.list[builtins.str]:
        r"""
        Each channel's name, as stored in the file.
        """
    @property
    def units(self) -> builtins.list[builtins.str]:
        r"""
        Each channel's unit symbol (`"µV"`, `"mV"`, …; empty for dimensionless values).
        """
    @property
    def metadata(self) -> builtins.dict[builtins.str, builtins.str]:
        r"""
        Format-specific metadata (key → value, as stored).
        """
    def __new__(cls, path: builtins.str, source: typing.Optional[builtins.str] = None) -> Recording:
        r"""
        Opens `path` (see the class docs).
        """
    @staticmethod
    def from_array(data: typing.Any, fs: builtins.float, *, name: builtins.str = 'array') -> Recording:
        r"""
        An in-memory recording of an array (copied; values unitless). For tests and derived signals;
        files open with `Recording(path)`.
        
        Parameters
        ----------
        data : numpy.ndarray
            `[channels, samples]`, converted to float32.
        fs : float
            Sampling rate, Hz.
        name : str, default "array"
            Name shown in `repr` and kept in sorting outputs.
        """
    def slice_samples(self, start_sample: builtins.int = 0, end_sample: typing.Optional[builtins.int] = None, channels: typing.Optional[typing.Sequence[builtins.int]] = None) -> Recording:
        r"""
        A lazy view (nothing read) over samples `[start_sample, end_sample)` and some channels.
        
        Parameters
        ----------
        start_sample : int, default 0
        end_sample : int, optional
            Exclusive; default: the end of the recording.
        channels : list of int, optional
            Channel indices, in the order wanted; default: all.
        
        Returns
        -------
        Recording
        """
    def slice_time(self, start_sec: builtins.float = 0.0, end_sec: typing.Optional[builtins.float] = None, duration_sec: typing.Optional[builtins.float] = None, channels: typing.Optional[typing.Sequence[builtins.int]] = None) -> Recording:
