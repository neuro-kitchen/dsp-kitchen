def decompose_hdemg_cbss(data: typing.Any, *, fs: builtins.float, extension_factor: builtins.int, num_sources: builtins.int, refractory_ms: builtins.float, min_pnr_db: typing.Optional[builtins.float] = None, runtime: typing.Optional[builtins.str] = None) -> list:
    r"""
    Motor units of HD-EMG by convolutive blind source separation: delayed copies of the channels
