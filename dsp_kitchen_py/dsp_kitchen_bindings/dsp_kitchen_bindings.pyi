        channels : list of int, optional
            Channel indices; default: all.
        
        Returns
        -------
        Recording
        """
    def __getitem__(self, key: typing.Any) -> Recording:
        r"""
        A lazy view: `rec[start:end]` selects samples, `rec[channels, start:end]` channels and samples.
        
