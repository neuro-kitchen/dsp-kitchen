def localize_spikes(snippets: typing.Sequence[WaveformSnippet], probe: ProbeLayout, method: builtins.str = 'center_of_mass', *, max_iterations: typing.Optional[builtins.int] = None) -> numpy.typing.NDArray[numpy.float32]:
    r"""
