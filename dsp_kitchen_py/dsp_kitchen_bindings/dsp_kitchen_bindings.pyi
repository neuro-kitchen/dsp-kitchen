    -------
    list of dict
        One per unit: `unit_id`, `spike_samples`, `pnr_db`, `cov_isi` (coefficient of variation of the
        inter-spike intervals), `ipt` (the source's innervation pulse train, float32).
    """

def deduplicate_spikes(spikes: typing.Sequence[SpikeEvent], probe: ProbeLayout, *, radius_um: builtins.float, window_samples: builtins.int) -> builtins.list[DeduplicatedSpike]:
    r"""
    One spike per action potential: a crossing survives unless a stronger one is within `radius_um`
    on the probe and `window_samples` in time.
    
    Parameters
    ----------
    spikes : list of SpikeEvent
        Crossings, e.g. from `detect_spikes`.
    probe : ProbeLayout
        Contact positions (channel distances).
    radius_um : float
        Spatial radius, µm.
    window_samples : int
        Time window, samples.
    
    Returns
    -------
    list of DeduplicatedSpike
        With the strongest channel and every channel merged into each spike.
    """

def detect_recording(recording: Recording, pipeline: Pipeline, probe: ProbeLayout, *, threshold_factor: typing.Optional[builtins.float] = None, refractory_ms: typing.Optional[builtins.float] = None, polarity: typing.Optional[builtins.str] = None, distance_rule: typing.Optional[builtins.str] = None, spatial_radius_um: typing.Optional[builtins.float] = None, k_neighbors: typing.Optional[builtins.int] = None, pre_ms: typing.Optional[builtins.float] = None, post_ms: typing.Optional[builtins.float] = None, batch_duration_sec: typing.Optional[builtins.float] = None, calibration_duration_sec: typing.Optional[builtins.float] = None, calibration_chunks: typing.Optional[builtins.int] = None, apply_sinc_shift: typing.Optional[builtins.bool] = None, start_sec: typing.Optional[builtins.float] = None, duration_sec: typing.Optional[builtins.float] = None, runtime: typing.Optional[builtins.str] = None) -> StreamingDetectionResult:
    r"""
    Detects spikes in a whole recording: windows are read with halos, run through `pipeline` on the
    device, thresholded, deduplicated across channels and cut into snippets, with bounded memory. Any
    batch length gives the same spikes as processing the recording in one piece.
    
    Parameters
    ----------
    recording : Recording
    pipeline : Pipeline
        Preprocessing (e.g. `[CommonAverageReference(), BandpassFilter(300.0, 5000.0)]`).
    probe : ProbeLayout
    threshold_factor : float, default 5.0
        Threshold in multiples of each channel's noise σ (MAD, calibrated on the first chunks).
    refractory_ms : float, default 1.0
        Smallest interval between two crossings on a channel, ms.
    polarity : {"negative", "positive", "both"}, default "negative"
    distance_rule : {"locally-exclusive", "scipy"}, default "locally-exclusive"
        See `detect_spikes`.
    spatial_radius_um : float, default 150.0
        Crossings within this radius (and the refractory window) are one spike.
    k_neighbors : int, default 4
        Channels of each snippet (the primary and its nearest).
    pre_ms, post_ms : float, default 1.0, 2.0
        Snippet window before and after each spike, ms.
    batch_duration_sec : float, default 10.0
        Length of each window, s (memory, not results).
    calibration_duration_sec : float, default 5.0
        Length of each noise-calibration chunk, s.
    calibration_chunks : int, default 5
        Chunks the noise σ is estimated from.
    apply_sinc_shift : bool, default True
        Realign snippets to the sub-sample trough (sinc interpolation).
    start_sec, duration_sec : float, optional
        Detect only in this window; default: the whole recording.
    runtime : str, optional
        Compute runtime (`"wgpu"`, `"cuda"`, `"cpu"`, …); default: the current one.
    
    Returns
    -------
    StreamingDetectionResult
    """

def detect_spikes(data: typing.Any, *, refractory_samples: builtins.int, threshold_factor: typing.Optional[builtins.float] = None, polarity: typing.Optional[builtins.str] = None, distance_rule: typing.Optional[builtins.str] = None, sigmas: typing.Optional[typing.Sequence[builtins.float]] = None) -> builtins.list[SpikeEvent]:
    r"""
    Threshold crossings: on each channel, local extrema beyond `threshold_factor · σ`, at least
    `refractory_samples` apart.
    
    Parameters
    ----------
    data : numpy.ndarray
        `[channels, samples]`, converted to float32 (filtered first, e.g. 300–5000 Hz).
    refractory_samples : int
        Smallest distance between two crossings on a channel, samples.
    threshold_factor : float, default 5.0
        Threshold in multiples of each channel's noise σ.
    polarity : {"negative", "positive", "both"}, default "negative"
        Which extrema count (extracellular spikes are mostly negative).
    distance_rule : {"locally-exclusive", "scipy"}, default "locally-exclusive"
        `"locally-exclusive"`: a crossing stays unless a larger one is closer than `refractory_samples`
        (exact when data is processed in chunks); `"scipy"`: `scipy.signal.find_peaks`' `distance`.
    sigmas : list of float, optional
        Noise σ of every channel (e.g. from `estimate_noise` on a quiet stretch); default: each channel's
        MAD / 0.6745 over `data`.
    
    Returns
    -------
    list of SpikeEvent
        One per crossing (channel, sample, amplitude). The same spike on several channels gives several
        crossings: see `deduplicate_spikes`.
    """

