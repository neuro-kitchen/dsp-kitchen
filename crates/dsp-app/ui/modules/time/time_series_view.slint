import { Theme, Metrics } from "../../shell/theme.slint";
import { LaneLabel, TimeTick } from "time_types.slint";

// Plot of one view: channel gutter, raster image with overlays, time axis.
// Its plot area must be exactly (width - Metrics.gutter) × (height - Metrics.axis):
// Rust renders the raster at that size.
export component TimeSeriesView inherits Rectangle {
    in property <image> waveform_image;
    in property <[LaneLabel]> lanes;
    in property <[TimeTick]> ticks;
    in property <string> hover_readout;
    in property <string> scale_bar_label;
    // Vertical center of the scale bar as a fraction of the plot height
    in property <float> scale_bar_frac;
    in property <bool> is_heatmap: false;

    // Zoom factor and cursor x (logical px) to anchor the zoom
    callback zoom_at(float, length);
    // Incremental drag delta since the previous move event (logical px)
    callback pan_pixels(length);
    callback zoom_amplitude(float);
    callback scroll_channels(int);
    callback hover_at(length, length);
    callback plot_double_clicked(length);
    callback pressed();

    background: Theme.plot-bg;

    HorizontalLayout {
        // Channel label gutter
        gutter := Rectangle {
            width: Metrics.gutter;
            clip: true;

            for lane[i] in root.lanes: Text {
                x: 10px;
                y: lane.y_frac * plot.height - self.height / 2;
                text: lane.label;
                color: lane.color;
                font-size: Theme.font-small;
                font-weight: (!root.is_heatmap && touch.has-hover
                    && Math.floor(touch.mouse-y / plot.height * root.lanes.length) == i) ? 800 : 500;
            }
        }

        VerticalLayout {
            plot := Rectangle {
                clip: true;

                // Plot raster (rendered off the UI thread at physical resolution)
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.waveform_image;
                    image-fit: fill;
                }

                // Hover crosshair
                if touch.has-hover: Rectangle {
                    x: touch.mouse-x;
                    width: 1px;
                    height: 100%;
                    background: Theme.crosshair;
                }

                // Scale bar label (bar itself is drawn in the raster at the right edge)
                if root.scale_bar_label != "": Rectangle {
                    x: plot.width - 20px - self.width;
                    y: root.scale_bar_frac * plot.height - self.height / 2;
                    width: bar_text.preferred-width + 8px;
                    height: bar_text.preferred-height + 2px;
                    border-radius: 3px;
                    background: #090d13cc;
                    bar_text := Text {
                        text: root.scale_bar_label;
                        color: Theme.text;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Hover readout (time, channel, value)
                if touch.has-hover && root.hover_readout != "": Rectangle {
                    x: plot.width - self.width - 8px;
                    y: 8px;
                    height: 22px;
                    width: readout.preferred-width + 16px;
                    border-radius: Theme.radius;
                    background: #161b22e6;
                    border-width: 1px;
                    border-color: Theme.border;
                    readout := Text {
                        text: root.hover_readout;
                        color: Theme.text;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.crosshair;
                    property <length> last_drag_x;

                    // Wheel: zoom time at cursor · Ctrl = gain · Shift = scroll channels ·
                    // horizontal (touchpad) = pan
                    scroll-event(event) => {
                        if (event.modifiers.control) {
                            if (event.delta_y != 0) {
                                root.zoom_amplitude(event.delta_y > 0 ? 1.1 : 1.0 / 1.1);
                            }
                        } else if (event.modifiers.shift) {
                            let d = event.delta_y != 0 ? event.delta_y : event.delta_x;
                            if (d != 0) {
                                root.scroll_channels(d > 0 ? -1 : 1);
                            }
                        } else if (Math.abs(event.delta_x) > Math.abs(event.delta_y)) {
                            root.pan_pixels(event.delta_x);
                        } else if (event.delta_y > 0) {
                            root.zoom_at(0.8, self.mouse_x); // zoom in
                        } else if (event.delta_y < 0) {
                            root.zoom_at(1.25, self.mouse_x); // zoom out
                        }
                        accept
                    }

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.last_drag_x = self.mouse_x;
                            root.pressed();
                        }
                    }

                    // Drag to pan: send only the delta since the last move event
                    moved => {
                        if (self.pressed) {
                            root.pan_pixels(self.mouse_x - self.last_drag_x);
                            self.last_drag_x = self.mouse_x;
                        }
                    }

                    double-clicked => {
                        root.plot_double_clicked(self.mouse_y);
                    }

                    changed mouse-x => {
                        root.hover_at(self.mouse_x, self.mouse_y);
                    }
                    changed mouse-y => {
                        root.hover_at(self.mouse_x, self.mouse_y);
                    }
                }
            }

            // Time axis
            axis := Rectangle {
                height: Metrics.axis;
                clip: true;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.border;
                }
                for tick in root.ticks: Rectangle {
                    x: tick.frac * axis.width;
                    y: 0px;
                    width: 1px;
                    height: 4px;
                    background: Theme.border-hover;
                }
                for tick in root.ticks: Text {
                    x: Math.clamp(tick.frac * axis.width - self.width / 2, 0px, axis.width - self.width);
                    y: 6px;
                    text: tick.label;
                    color: Theme.text-muted;
                    font-size: 10px;
                }
            }
        }
    }
}
