import { SpinBox, ComboBox, Button } from "std-widgets.slint";
import { Theme } from "../../shell/theme.slint";
import { AppState, AppLogic } from "../../shell/app_logic.slint";
import { SpikeViewKind } from "spike_types.slint";
import { SpikeState, SpikeLogic } from "spike_logic.slint";

component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    font-weight: 700;
}

component Label inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    vertical-alignment: center;
    width: 64px;
}

// Right panel of the Spike module: sorting parameters and the focused spike view.
export component SortingProperties inherits Rectangle {
    background: Theme.surface;
    clip: true;

    Rectangle {
        x: 0px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        alignment: start;

        SectionTitle { text: "SPIKE SORTING"; }
        Text {
            text: AppState.sort_status;
            color: AppState.sort_running ? Theme.accent : Theme.text;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Label { text: "Clusters"; }
            SpinBox {
                minimum: 1;
                maximum: 64;
                value: SpikeState.sort_k;
                edited(v) => { SpikeLogic.set_num_clusters(v); }
            }
        }
        Button {
            text: AppState.sort_running ? "Sorting…" : "Run sorting";
            enabled: !AppState.sort_running;
            clicked => { AppLogic.run_sorting(); }
        }
        Text {
            text: "Density-peaks on PCA + depth. Probe geometry is assumed linear; co-detections merge by time.";
            color: Theme.text-dim;
            font-size: 10px;
            wrap: word-wrap;
        }

        Rectangle { height: 1px; background: Theme.border; }

        SectionTitle { text: "VIEW"; }

        if !SpikeState.focused.valid: Text {
            text: "Select a view, or add one from the View menu.";
            color: Theme.text-muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }

        if SpikeState.focused.valid: VerticalLayout {
            spacing: 10px;

            Text {
                text: SpikeState.focused.title;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 8px;
                Label { text: "Type"; }
                ComboBox {
                    // Same order as SpikeViewKind
                    model: ["Waveforms", "Features", "Correlograms", "ISI", "Amplitudes"];
                    current-index: SpikeState.focused.kind_index;
                    selected => { SpikeLogic.set_view_kind(SpikeState.focused.view_id, self.current-index); }
                }
            }

            if SpikeState.focused.kind == SpikeViewKind.features: HorizontalLayout {
                spacing: 8px;
                Label { text: "Axes"; }
                ComboBox {
                    // Same order as FeatureAxes::ALL
                    model: ["PC1 vs PC2", "PC1 vs PC3", "PC2 vs PC3", "PC1 vs depth"];
                    current-index: SpikeState.focused.feature_axes;
                    selected => { SpikeLogic.set_feature_axes(SpikeState.focused.view_id, self.current-index); }
                }
            }
        }
    }
}
