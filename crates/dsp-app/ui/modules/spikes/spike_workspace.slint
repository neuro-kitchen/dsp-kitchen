import { Theme } from "../../shell/theme.slint";
import { SeatFrame, EmptyHint } from "../../shell/seat_frame.slint";
import { Splitter } from "../../shell/splitter.slint";
import { SpikeState, SpikeLogic } from "spike_logic.slint";
import { SpikePlotView } from "spike_plot_view.slint";

// Dock of the Spike module: seats and gutters placed by Rust.
export component SpikeWorkspace inherits Rectangle {
    background: Theme.window-bg;

    init => { SpikeLogic.workspace_resized(self.width, self.height); }
    changed width => { SpikeLogic.workspace_resized(self.width, self.height); }
    changed height => { SpikeLogic.workspace_resized(self.width, self.height); }

    for seat in SpikeState.seats: SeatFrame {
        x: seat.x;
        y: seat.y;
        width: seat.width;
        height: seat.height;
        module: 1;
        tabs: seat.tabs;
        active: seat.active;
        focused: seat.focused;
        view_id: seat.view_id;

        activate(v) => { SpikeLogic.activate_view(v); }
        close(v) => { SpikeLogic.close_view(v); }
        dropped(v, side) => { SpikeLogic.dock_drop(v, seat.view_id, side); }

        if seat.empty_message == "": SpikePlotView {
            image: seat.image;
            y_labels: seat.y_labels;
            x_labels: seat.x_labels;
            note: seat.note;
            pressed => { SpikeLogic.focus_view(seat.view_id); }
        }
        if seat.empty_message != "": EmptyHint {
            text: seat.empty_message;
        }
    }

    for divider in SpikeState.dividers: Splitter {
        x: divider.x;
        y: divider.y;
        width: divider.width;
        height: divider.height;
        columns: divider.columns;
        pressed => { SpikeLogic.divider_pressed(divider.index); }
        moved(delta) => { SpikeLogic.divider_dragged(divider.index, delta); }
    }
}
