// Types of the Spike module.

import { TabData } from "../../shell/types.slint";

export enum SpikeViewKind { waveforms, features, correlograms, isi, amplitudes }

// A value-axis label at a fraction of the plot (x from the left, y from the top).
export struct AxisLabel {
    label: string,
    frac: float,
}

// One seat of the spike workspace, placed by Rust (logical px), with its active view's state.
export struct SpikeSeat {
    x: length,
    y: length,
    width: length,
    height: length,
    tabs: [TabData],
    active: int,
    // -1 when the seat is empty
    view_id: int,
    kind: SpikeViewKind,
    focused: bool,
    image: image,
    y_labels: [AxisLabel],
    x_labels: [AxisLabel],
    note: string,
    empty_message: string,
}

// One cluster of the spike sorting.
export struct ClusterRow {
    id: int,
    // Selection color; transparent when not selected
    color: color,
    selected: bool,
    channel: int,
    spikes: int,
    amplitude: string,
    rate: string,
    snr: string,
    isi: string,
    // ISI violations above 1% (likely multi-unit)
    isi_bad: bool,
}

// Settings of the focused spike view.
export struct SpikeFocused {
    valid: bool,
    view_id: int,
    title: string,
    kind: SpikeViewKind,
    // Index into SpikeViewKind order (type combo box)
    kind_index: int,
    // Feature view: index into the axes choices
    feature_axes: int,
}
