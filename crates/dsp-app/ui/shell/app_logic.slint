// Parent app state (Rust → UI) and intents (UI → Rust). Module-specific state lives in each
// module's own globals (TimeState/TimeLogic, SpikeState/SpikeLogic).

export global AppState {
    // Shared data
    in-out property <string> dataset_name;
    in-out property <string> dataset_info;
    in-out property <int> channel_count: 0;
    in-out property <float> sample_rate: 0;
    in-out property <int> total_spikes_detected: 0;
    in-out property <string> sort_status;
    in-out property <bool> sort_running: false;

    // Shell
    // 0 = Time, 1 = Spikes
    in-out property <int> active_module: 0;
    in-out property <[string]> recent_files;
    in-out property <string> status_message;
    in-out property <bool> show_help: false;
    in-out property <bool> show_about: false;
    // Bumped by Rust to hand keyboard focus back to the shortcut scope
    in-out property <int> focus_request: 0;
}

export global AppLogic {
    callback open_file();
    callback open_recent(int);
    callback quit();
    callback set_module(int);
    callback run_sorting();
    // Build the min/max cache of the open file (zoomed-out drawing)
    callback build_cache();
    // Act on the active module
    callback reset_layout();
    callback compact_layout();

    // Drag-and-drop payload for dock views: (module, view id)
    pure callback view_to_transfer(int, int) -> data-transfer;
    // View id if the payload is a view of `module`, else -1
    pure callback transfer_to_view(int, data-transfer) -> int;
}
