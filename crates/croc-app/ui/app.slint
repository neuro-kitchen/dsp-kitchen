// Crock-App: High-Performance Electrophysiology & Signal Viewer in Slint
// Android-style MVVM Architecture: View Layer Assembly

import { Header } from "components/header.slint";
import { TimeSeriesView } from "components/time_series_view.slint";
import { TimelinePanel } from "components/timeline_panel.slint";

export struct TimeTick {
    pos_pct: float,
    label: string,
}

export global AppState {
    in-out property <string> dataset_name: "mearec_32ch_10s.bin";
    in-out property <int> channel_count: 32;
    in-out property <float> sample_rate: 32000.0;
    in-out property <float> total_duration_sec: 10.0;
    in-out property <float> current_time_sec: 2.45;
    in-out property <float> visible_window_sec: 0.100;
    in-out property <float> window_start_sec: 2.40;
    in-out property <bool> is_playing: false;
    in-out property <bool> loop_playback: true;
    in-out property <float> playback_speed: 1.0;
    in-out property <float> amplitude_scale: 1.0;
    in-out property <int> active_channel_offset: 0;
    in-out property <int> visible_channels_count: 8;
    in-out property <int> total_spikes_detected: 740;
    in-out property <string> time_readout: "00:02.450 / 00:10.000";
    in-out property <string> channel_label_range: "Ch 0 - Ch 7 (of 32)";
    in-out property <string> status_message: "Screen LOD Decimation: Active (O(W) memory)";
    in-out property <image> waveform_image;
    in-out property <[TimeTick]> time_ticks;
}

export global AppLogic {
    callback toggle_play_pause();
    callback step_forward();
    callback step_backward();
    callback jump_to_start();
    callback jump_to_end();
    callback toggle_loop();
    callback set_playback_speed(float);
    callback set_window_duration(float);
    callback scrub_to_ratio(float);
    callback zoom_time(float);
    callback pan_time(float);
    callback zoom_amplitude(float);
    callback next_channel_page();
    callback prev_channel_page();
    callback canvas_resized(length, length);
}

export component AppWindow inherits Window {
    title: "Croc Signal Viewer (Slint)";
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1200px;
    preferred-height: 750px;
    background: #0d1117;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. Modular Header Component
        Header {
            dataset_name: AppState.dataset_name;
            channel_count: AppState.channel_count;
            sample_rate: AppState.sample_rate;
            visible_window_sec: AppState.visible_window_sec;
            amplitude_scale: AppState.amplitude_scale;
            channel_label_range: AppState.channel_label_range;

            set_window_duration(d) => { AppLogic.set_window_duration(d); }
            zoom_amplitude(f) => { AppLogic.zoom_amplitude(f); }
            prev_channel_page() => { AppLogic.prev_channel_page(); }
            next_channel_page() => { AppLogic.next_channel_page(); }
        }

        // 2. Modular Central Time Series Viewport Component
        TimeSeriesView {
            waveform_image: AppState.waveform_image;
            visible_window_sec: AppState.visible_window_sec;

            zoom_time(f) => { AppLogic.zoom_time(f); }
            pan_time(dt) => { AppLogic.pan_time(dt); }
            canvas_resized(w, h) => { AppLogic.canvas_resized(w, h); }
        }

        // 3. Modular Timeline Panel Component
        TimelinePanel {
            total_duration_sec: AppState.total_duration_sec;
            current_time_sec: AppState.current_time_sec;
            visible_window_sec: AppState.visible_window_sec;
            window_start_sec: AppState.window_start_sec;
            is_playing: AppState.is_playing;
            loop_playback: AppState.loop_playback;
            playback_speed: AppState.playback_speed;
            time_readout: AppState.time_readout;
            total_spikes_detected: AppState.total_spikes_detected;
            status_message: AppState.status_message;

            toggle_play_pause() => { AppLogic.toggle_play_pause(); }
            step_forward() => { AppLogic.step_forward(); }
            step_backward() => { AppLogic.step_backward(); }
            jump_to_start() => { AppLogic.jump_to_start(); }
            jump_to_end() => { AppLogic.jump_to_end(); }
            toggle_loop() => { AppLogic.toggle_loop(); }
            set_playback_speed(s) => { AppLogic.set_playback_speed(s); }
            scrub_to_ratio(r) => { AppLogic.scrub_to_ratio(r); }
        }
    }
}
