// Croc-App: Electrophysiology & Signal Workbench in Slint
// Android-style MVVM Architecture: View Layer Assembly

import { Theme, Metrics } from "theme.slint";
import { ViewKind, DropSide, LaneLabel, TimeTick, TabData, SeatData, DividerData, ChannelRow, FocusedView } from "types.slint";
import { AppState, AppLogic } from "logic.slint";
import { Workspace } from "components/workspace.slint";
import { DataPanel } from "components/data_panel.slint";
import { PropertiesPanel } from "components/properties_panel.slint";
import { TimelinePanel } from "components/timeline_panel.slint";
import { Overlay, ShortcutList } from "components/overlays.slint";

export { Theme, Metrics, AppState, AppLogic, ViewKind, DropSide, LaneLabel, TimeTick, TabData, SeatData, DividerData, ChannelRow, FocusedView }

export component AppWindow inherits Window {
    title: AppState.dataset_name == "" ? "Croc" : AppState.dataset_name + " — Croc";
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-bg;
    forward-focus: shortcuts;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => { AppLogic.open_file(); }
            }
            Menu {
                title: "Open Recent";
                for path[i] in AppState.recent_files: MenuItem {
                    title: path;
                    activated => { AppLogic.open_recent(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                shortcut: @keys(Control + Q);
                activated => { AppLogic.quit(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Add Traces View";
                shortcut: @keys(Control + T);
                activated => { AppLogic.add_view(ViewKind.traces); }
            }
            MenuItem {
                title: "Add Heatmap View";
                shortcut: @keys(Control + H);
                activated => { AppLogic.add_view(ViewKind.heatmap); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Data Panel";
                checked: AppState.show_data;
                activated => { AppLogic.toggle_panel(0); }
            }
            MenuItem {
                title: "Properties Panel";
                checked: AppState.show_properties;
                activated => { AppLogic.toggle_panel(1); }
            }
            MenuItem {
                title: "Time Panel";
                checked: AppState.show_timeline;
                activated => { AppLogic.toggle_panel(2); }
            }
        }
        Menu {
            title: "Layout";
            MenuItem {
                title: "Reset to Default";
                activated => { AppLogic.reset_layout(); }
            }
            MenuItem {
                title: "All Views as Tabs";
                activated => { AppLogic.compact_layout(); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                shortcut: @keys(F1);
                activated => { AppState.show_help = true; }
            }
            MenuItem {
                title: "About Croc";
                activated => { AppState.show_about = true; }
            }
        }
    }

    // Rust bumps focus_request to return keyboard focus to the shortcut scope
    property <int> focus-request: AppState.focus_request;
    changed focus-request => { shortcuts.focus(); }

    // Keyboard shortcuts act on the focused view and the shared timeline
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                AppLogic.toggle_play_pause();
            } else if (event.text == Key.LeftArrow) {
                AppLogic.pan_fraction(event.modifiers.shift ? -1.0 : -0.1);
            } else if (event.text == Key.RightArrow) {
                AppLogic.pan_fraction(event.modifiers.shift ? 1.0 : 0.1);
            } else if (event.text == Key.UpArrow) {
                AppLogic.focused_scroll(-1);
            } else if (event.text == Key.DownArrow) {
                AppLogic.focused_scroll(1);
            } else if (event.text == Key.PageUp) {
                AppLogic.focused_page(false);
            } else if (event.text == Key.PageDown) {
                AppLogic.focused_page(true);
            } else if (event.text == Key.Home) {
                AppLogic.jump_to_start();
            } else if (event.text == Key.End) {
                AppLogic.jump_to_end();
            } else if (event.text == "+" || event.text == "=") {
                AppLogic.zoom_center(0.8);
            } else if (event.text == "-") {
                AppLogic.zoom_center(1.25);
            } else if (event.text == "]") {
                AppLogic.focused_gain(1.0 / 0.75);
            } else if (event.text == "[") {
                AppLogic.focused_gain(0.75);
            } else if (event.text == "l") {
                AppLogic.toggle_loop();
            } else if (event.text == Key.Escape) {
                AppState.show_help = false;
                AppState.show_about = false;
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                if AppState.show_data: DataPanel {
                    width: 230px;
                }

                Workspace {
                    horizontal-stretch: 1;
                }

                if AppState.show_properties: PropertiesPanel {
                    width: 264px;
                }
            }

            if AppState.show_timeline: TimelinePanel {
                total_duration_sec: AppState.total_duration_sec;
                current_time_sec: AppState.current_time_sec;
                visible_window_sec: AppState.visible_window_sec;
                window_start_sec: AppState.window_start_sec;
                is_playing: AppState.is_playing;
                loop_playback: AppState.loop_playback;
                playback_speed: AppState.playback_speed;
                time_readout: AppState.time_readout;
                total_spikes_detected: AppState.total_spikes_detected;
                status_message: AppState.status_message;
                overview_image: AppState.overview_image;
                channel_count: AppState.channel_count;
                sample_rate: AppState.sample_rate;

                toggle_play_pause() => { AppLogic.toggle_play_pause(); }
                step_forward() => { AppLogic.step_forward(); }
                step_backward() => { AppLogic.step_backward(); }
                jump_to_start() => { AppLogic.jump_to_start(); }
                jump_to_end() => { AppLogic.jump_to_end(); }
                toggle_loop() => { AppLogic.toggle_loop(); }
                set_playback_speed(s) => { AppLogic.set_playback_speed(s); }
                scrub_to_ratio(r) => { AppLogic.scrub_to_ratio(r); }
                pan_overview(r) => { AppLogic.pan_overview(r); }
                set_window_edges(a, b) => { AppLogic.set_window_edges(a, b); }
                overview_resized(w, h) => { AppLogic.overview_resized(w, h); }
            }
        }

        if AppState.show_help: Overlay {
            title: "Keyboard & Mouse";
            close => { AppState.show_help = false; }
            ShortcutList { }
        }

        if AppState.show_about: Overlay {
            title: "About Croc";
            close => { AppState.show_about = false; }
            Text {
                text: "Croc — a signal-processing workbench built on dsp-kitchen.\nViews dock like Rerun: drag tabs to split or stack them.";
                color: Theme.text;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}
