// Croc: signal workbench. Parent app shell hosting the Time and Spikes modules.

import { Theme, Metrics } from "shell/theme.slint";
import { DropSide, TabData, DividerData } from "shell/types.slint";
import { AppState, AppLogic } from "shell/app_logic.slint";
import { ModuleTabs } from "shell/module_tabs.slint";
import { Overlay, ShortcutList } from "shell/overlays.slint";
import { TimeViewKind, LaneLabel, TimeTick, TimeSeat, ChannelRow, TimeFocused } from "modules/time/time_types.slint";
import { TimeState, TimeLogic } from "modules/time/time_logic.slint";
import { TimeModule } from "modules/time/time_module.slint";
import { SpikeViewKind, AxisLabel, SpikeSeat, ClusterRow, SpikeFocused } from "modules/spikes/spike_types.slint";
import { SpikeState, SpikeLogic } from "modules/spikes/spike_logic.slint";
import { SpikeModule } from "modules/spikes/spike_module.slint";

export { Theme, Metrics, AppState, AppLogic, DropSide, TabData, DividerData }
export { TimeViewKind, LaneLabel, TimeTick, TimeSeat, ChannelRow, TimeFocused, TimeState, TimeLogic }
export { SpikeViewKind, AxisLabel, SpikeSeat, ClusterRow, SpikeFocused, SpikeState, SpikeLogic }

export component AppWindow inherits Window {
    title: AppState.dataset_name == "" ? "Croc" : AppState.dataset_name + " — Croc";
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-bg;
    forward-focus: shortcuts;

    property <bool> time-active: AppState.active_module == 0;
    property <bool> spikes-active: AppState.active_module == 1;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => { AppLogic.open_file(); }
            }
            Menu {
                title: "Open Recent";
                for path[i] in AppState.recent_files: MenuItem {
                    title: path;
                    activated => { AppLogic.open_recent(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                shortcut: @keys(Control + Q);
                activated => { AppLogic.quit(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Time Module";
                checked: root.time-active;
                activated => { AppLogic.set_module(0); }
            }
            MenuItem {
                title: "Spikes Module";
                checked: root.spikes-active;
                activated => { AppLogic.set_module(1); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Add Traces View";
                shortcut: @keys(Control + T);
                enabled: root.time-active;
                activated => { TimeLogic.add_view(0); }
            }
            MenuItem {
                title: "Add Heatmap View";
                shortcut: @keys(Control + H);
                enabled: root.time-active;
                activated => { TimeLogic.add_view(1); }
            }
            Menu {
                title: "Add Traces for";
                enabled: root.time-active;
                for name[i] in TimeState.source-names: MenuItem {
                    title: name;
                    activated => { TimeLogic.add_view_for_source(i); }
                }
            }
            Menu {
                title: "Add Spike View";
                enabled: root.spikes-active;
                MenuItem { title: "Waveforms"; activated => { SpikeLogic.add_view(0); } }
                MenuItem { title: "Features (PCA)"; activated => { SpikeLogic.add_view(1); } }
                MenuItem { title: "Correlograms"; activated => { SpikeLogic.add_view(2); } }
                MenuItem { title: "ISI"; activated => { SpikeLogic.add_view(3); } }
                MenuItem { title: "Amplitudes"; activated => { SpikeLogic.add_view(4); } }
            }
            MenuSeparator { }
            MenuItem {
                title: "Channels Panel";
                enabled: root.time-active;
                checked: TimeState.show_data;
                activated => { TimeLogic.toggle_panel(0); }
            }
            MenuItem {
                title: "Timeline";
                enabled: root.time-active;
                checked: TimeState.show_timeline;
                activated => { TimeLogic.toggle_panel(2); }
            }
            MenuItem {
                title: "Clusters Panel";
                enabled: root.spikes-active;
                checked: SpikeState.show_clusters;
                activated => { SpikeLogic.toggle_panel(0); }
            }
            MenuItem {
                title: "Properties Panel";
                checked: root.time-active ? TimeState.show_properties : SpikeState.show_properties;
                activated => {
                    if (root.time-active) {
                        TimeLogic.toggle_panel(1);
                    } else {
                        SpikeLogic.toggle_panel(1);
                    }
                }
            }
        }
        Menu {
            title: "Time";
            enabled: root.time-active;
            MenuItem {
                title: "Play / Pause";
                activated => { TimeLogic.toggle_play_pause(); }
            }
            MenuItem {
                title: "Show Sorted Spikes";
                checked: TimeState.show_sorted_spikes;
                activated => { TimeLogic.set_show_sorted_spikes(!TimeState.show_sorted_spikes); }
            }
        }
        Menu {
            title: "Spikes";
            enabled: root.spikes-active;
            MenuItem {
                title: "Run Sorting";
                shortcut: @keys(Control + R);
                enabled: !AppState.sort_running;
                activated => { AppLogic.run_sorting(); }
            }
            MenuItem {
                title: "Next Cluster";
                activated => { SpikeLogic.step_cluster(1); }
            }
            MenuItem {
                title: "Previous Cluster";
                activated => { SpikeLogic.step_cluster(-1); }
            }
        }
        Menu {
            title: "Layout";
            MenuItem {
                title: "Reset Module Layout";
                activated => { AppLogic.reset_layout(); }
            }
            MenuItem {
                title: "All Views as Tabs";
                activated => { AppLogic.compact_layout(); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                shortcut: @keys(F1);
                activated => { AppState.show_help = true; }
            }
            MenuItem {
                title: "About Croc";
                activated => { AppState.show_about = true; }
            }
        }
    }

    // Rust bumps focus_request to return keyboard focus to the shortcut scope
    property <int> focus-request: AppState.focus_request;
    changed focus-request => { shortcuts.focus(); }

    // Shortcuts are routed to the active module
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == "1" || event.text == "2") {
                AppLogic.set_module(event.text == "1" ? 0 : 1);
                return accept;
            }
            if (event.text == Key.Escape) {
                AppState.show_help = false;
                AppState.show_about = false;
                return accept;
            }
            if (root.spikes-active) {
                if (event.text == "j" || event.text == Key.DownArrow) {
                    SpikeLogic.step_cluster(1);
                } else if (event.text == "k" || event.text == Key.UpArrow) {
                    SpikeLogic.step_cluster(-1);
                } else {
                    return reject;
                }
                return accept;
            }
            if (event.text == " ") {
                TimeLogic.toggle_play_pause();
            } else if (event.text == Key.LeftArrow) {
                TimeLogic.pan_fraction(event.modifiers.shift ? -1.0 : -0.1);
            } else if (event.text == Key.RightArrow) {
                TimeLogic.pan_fraction(event.modifiers.shift ? 1.0 : 0.1);
            } else if (event.text == Key.UpArrow) {
                TimeLogic.focused_scroll(-1);
            } else if (event.text == Key.DownArrow) {
                TimeLogic.focused_scroll(1);
            } else if (event.text == Key.PageUp) {
                TimeLogic.focused_page(false);
            } else if (event.text == Key.PageDown) {
                TimeLogic.focused_page(true);
            } else if (event.text == Key.Home) {
                TimeLogic.jump_to_start();
            } else if (event.text == Key.End) {
                TimeLogic.jump_to_end();
            } else if (event.text == "+" || event.text == "=") {
                TimeLogic.zoom_center(0.8);
            } else if (event.text == "-") {
                TimeLogic.zoom_center(1.25);
            } else if (event.text == "]") {
                TimeLogic.focused_gain(1.0 / 0.75);
            } else if (event.text == "[") {
                TimeLogic.focused_gain(0.75);
            } else if (event.text == "l") {
                TimeLogic.toggle_loop();
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            ModuleTabs { }

            if root.time-active: TimeModule {
                vertical-stretch: 1;
            }
            if root.spikes-active: SpikeModule {
                vertical-stretch: 1;
            }
        }

        if AppState.show_help: Overlay {
            title: "Keyboard & Mouse";
            close => { AppState.show_help = false; }
            ShortcutList { }
        }

        if AppState.show_about: Overlay {
            title: "About Croc";
            close => { AppState.show_about = false; }
            Text {
                text: "Croc — a signal-processing workbench built on dsp-kitchen.\nTime: browse channels and traces. Spikes: sort and inspect clusters.";
                color: Theme.text;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}
