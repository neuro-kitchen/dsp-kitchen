import { Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// Modal card centred over the window; clicking outside or "Close" dismisses it.
export component Overlay inherits Rectangle {
    in property <string> title;
    callback close();

    background: #0008;

    TouchArea {
        clicked => { root.close(); }
    }

    card := Rectangle {
        width: Math.min(460px, root.width - 40px);
        height: body.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;

        // Swallow clicks on the card
        TouchArea { }

        body := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text {
                text: root.title;
                color: Theme.text-strong;
                font-size: Theme.font-title;
                font-weight: 700;
            }
            @children
            HorizontalLayout {
                alignment: end;
                Button { text: "Close"; clicked => { root.close(); } }
            }
        }
    }
}

component Shortcut inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    spacing: 12px;
    Text { text: root.keys; color: Theme.accent; font-size: Theme.font-small; width: 150px; }
    Text { text: root.action; color: Theme.text; font-size: Theme.font-small; }
}

export component ShortcutList inherits VerticalLayout {
    spacing: 4px;
    Shortcut { keys: "Space"; action: "Play / pause"; }
    Shortcut { keys: "← / →  (Shift: full window)"; action: "Pan time"; }
    Shortcut { keys: "+ / −   ·   wheel"; action: "Zoom time (wheel: at cursor)"; }
    Shortcut { keys: "Home / End"; action: "Jump to start / end"; }
    Shortcut { keys: "↑ / ↓   ·   Shift+wheel"; action: "Scroll channels (focused view)"; }
    Shortcut { keys: "PgUp / PgDn"; action: "Page channels (focused view)"; }
    Shortcut { keys: "[ / ]   ·   Ctrl+wheel"; action: "Gain (focused view)"; }
    Shortcut { keys: "l"; action: "Toggle loop"; }
    Shortcut { keys: "Drag a tab"; action: "Dock: edge splits, centre joins as tab"; }
    Shortcut { keys: "Double-click heatmap"; action: "Show that channel in a traces view"; }
}
