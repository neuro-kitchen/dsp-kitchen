export component TimeSeriesView inherits Rectangle {
    in property <image> waveform_image;
    in property <float> visible_window_sec: 0.100;

    callback zoom_time(float);
    callback pan_time(float);
    callback canvas_resized(length, length);

    background: #090d13;

    // Signal Waveform Raster Image (rendered via screen-space decimation)
    Image {
        width: 100%;
        height: 100%;
        source: root.waveform_image;
        image-fit: fill;
    }

    // Interactive Gestures on Signal Viewport
    viewport_touch := TouchArea {
        width: 100%;
        height: 100%;

        // Wheel zooming
        scroll-event(event) => {
            if (event.delta_y > 0) {
                root.zoom_time(0.8); // zoom in
            } else if (event.delta_y < 0) {
                root.zoom_time(1.25); // zoom out
            }
            accept
        }

        // Drag to pan
        moved => {
            if (viewport_touch.pressed) {
                let dx = (viewport_touch.mouse_x - viewport_touch.pressed_x) / 1px;
                let dt = -dx * (root.visible_window_sec / 800.0);
                root.pan_time(dt);
            }
        }
    }

    // Window dimension observer
    init => {
        root.canvas_resized(self.width, self.height);
    }
}
