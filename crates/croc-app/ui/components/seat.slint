import { Theme, Metrics } from "../theme.slint";
import { ViewKind, DropSide, SeatData } from "../types.slint";
import { AppLogic } from "../logic.slint";
import { TimeSeriesView } from "time_series_view.slint";

// One tab in a seat header: click to show, drag to move the view, × to close.
component SeatTab inherits Rectangle {
    in property <string> title;
    in property <int> view_id;
    in property <bool> active;
    in property <bool> seat_focused;

    height: Metrics.seat-header;
    width: row.preferred-width;
    background: root.active ? Theme.plot-bg : (tab_touch.has-hover ? Theme.surface-raised : transparent);

    // Accent underline on the active tab of the focused seat
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active && root.seat_focused ? Theme.accent : transparent;
    }

    DragArea {
        data: AppLogic.view_to_transfer(root.view_id);
        allow-move: true;
        opacity: self.dragging ? 0.5 : 1.0;

        tab_touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { AppLogic.activate_view(root.view_id); }
        }

        row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;
            Text {
                text: root.title;
                color: root.active ? Theme.text : Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: root.active ? 600 : 400;
                vertical-alignment: center;
            }
            // Close
            Rectangle {
                width: 16px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 16px;
                        border-radius: 3px;
                        background: close_touch.has-hover ? Theme.surface-pressed : transparent;
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? Theme.text-strong : Theme.text-dim;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        close_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { AppLogic.close_view(root.view_id); }
                        }
                    }
                }
            }
        }
    }
}

// A seat of the workspace: tab strip + the active view's plot. Dropping a dragged view on
// an edge splits the seat; on the middle or the tab strip it joins as a tab.
export component Seat inherits Rectangle {
    in property <SeatData> data;

    background: Theme.plot-bg;
    clip: true;

    VerticalLayout {
        // Tab strip
        Rectangle {
            height: Metrics.seat-header;
            background: Theme.surface;

            HorizontalLayout {
                alignment: start;
                for tab[i] in root.data.tabs: SeatTab {
                    title: tab.title;
                    view_id: tab.view_id;
                    active: i == root.data.active;
                    seat_focused: root.data.focused;
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        if root.data.empty_message == "": TimeSeriesView {
            waveform_image: root.data.image;
            lanes: root.data.lanes;
            ticks: root.data.ticks;
            hover_readout: root.data.hover_readout;
            scale_bar_label: root.data.scale_bar_label;
            scale_bar_frac: root.data.scale_bar_frac;
            is_heatmap: root.data.kind == ViewKind.heatmap;

            zoom_at(f, x) => { AppLogic.zoom_at(root.data.view_id, f, x); }
            pan_pixels(dx) => { AppLogic.pan_pixels(root.data.view_id, dx); }
            zoom_amplitude(f) => { AppLogic.zoom_gain(root.data.view_id, f); }
            scroll_channels(d) => { AppLogic.scroll_channels(root.data.view_id, d); }
            hover_at(x, y) => { AppLogic.hover_at(root.data.view_id, x, y); }
            plot_double_clicked(y) => { AppLogic.plot_double_clicked(root.data.view_id, y); }
            pressed => { AppLogic.focus_view(root.data.view_id); }
        }

        if root.data.empty_message != "": Rectangle {
            Text {
                text: root.data.empty_message;
                color: Theme.text-muted;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // Focus outline (overlay: does not change the plot size)
    Rectangle {
        border-width: 1px;
        border-color: root.data.focused ? #38bdf866 : Theme.border;
        background: transparent;
    }

    // Drop target: side from the pointer, previewed while a view hovers
    landing := DropArea {
        property <DropSide> side: DropSide.centre;

        function side_at(x: length, y: length) -> DropSide {
            // The tab strip and the middle join as a tab; an outer quarter splits
            if (y < Metrics.seat-header) {
                return DropSide.centre;
            }
            let fx = x / root.width;
            let fy = (y - Metrics.seat-header) / Math.max(1px, root.height - Metrics.seat-header);
            let edge = Math.min(Math.min(fx, 1 - fx), Math.min(fy, 1 - fy));
            if (edge > 0.25) {
                return DropSide.centre;
            }
            if (edge == fx) { return DropSide.left; }
            if (edge == 1 - fx) { return DropSide.right; }
            if (edge == fy) { return DropSide.top; }
            return DropSide.bottom;
        }

        can-drop(event) => {
            if (AppLogic.transfer_to_view(event.data) < 0) {
                return DragAction.none;
            }
            self.side = self.side_at(event.position.x, event.position.y);
            event.proposed-action
        }
        dropped(event) => {
            let view = AppLogic.transfer_to_view(event.data);
            if (view >= 0) {
                AppLogic.dock_drop(view, root.data.view_id, self.side_at(event.position.x, event.position.y));
            }
            event.proposed-action
        }
    }

    // Drop preview
    if landing.has-drag: Rectangle {
        x: landing.side == DropSide.right ? root.width / 2 : 0px;
        y: landing.side == DropSide.bottom ? root.height / 2 : 0px;
        width: (landing.side == DropSide.left || landing.side == DropSide.right) ? root.width / 2 : root.width;
        height: (landing.side == DropSide.top || landing.side == DropSide.bottom) ? root.height / 2 : root.height;
        background: #38bdf826;
        border-width: 2px;
        border-color: Theme.accent;
    }
}
