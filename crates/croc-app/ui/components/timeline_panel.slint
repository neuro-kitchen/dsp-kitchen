import { IconButton } from "../widgets/icon_button.slint";
import { PillButton } from "../widgets/pill_button.slint";

export component TimelinePanel inherits Rectangle {
    in property <float> total_duration_sec: 10.0;
    in property <float> current_time_sec: 0.0;
    in property <float> visible_window_sec: 0.100;
    in property <float> window_start_sec: 0.0;
    in property <bool> is_playing: false;
    in property <bool> loop_playback: true;
    in property <float> playback_speed: 1.0;
    in property <string> time_readout: "00:00.000 / 00:10.000";
    in property <int> total_spikes_detected: 0;
    in property <string> status_message: "Screen LOD Decimation: Active (O(W) memory)";

    callback toggle_play_pause();
    callback step_forward();
    callback step_backward();
    callback jump_to_start();
    callback jump_to_end();
    callback toggle_loop();
    callback set_playback_speed(float);
    callback scrub_to_ratio(float);

    height: 130px;
    background: #161b22;

    // Top border divider
    Rectangle {
        width: 100%;
        height: 1px;
        y: 0px;
        background: #30363d;
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;

        // 1. Playback Control Bar
        HorizontalLayout {
            height: 32px;
            alignment: space-between;

            // Transport Buttons
            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                IconButton {
                    icon_text: "⏮";
                    clicked => { root.jump_to_start(); }
                }
                IconButton {
                    icon_text: "◀";
                    clicked => { root.step_backward(); }
                }
                IconButton {
                    icon_text: root.is_playing ? "⏸" : "▶";
                    is_active: root.is_playing;
                    active_color: #38bdf8;
                    clicked => { root.toggle_play_pause(); }
                }
                IconButton {
                    icon_text: "▶";
                    clicked => { root.step_forward(); }
                }
                IconButton {
                    icon_text: "⏭";
                    clicked => { root.jump_to_end(); }
                }
                IconButton {
                    icon_text: "🔁";
                    is_active: root.loop_playback;
                    active_color: #a855f7;
                    clicked => { root.toggle_loop(); }
                }

                // Playback Speed
                PillButton {
                    text: "\{root.playback_speed}x";
                    clicked => {
                        if (root.playback_speed == 1.0) {
                            root.set_playback_speed(2.0);
                        } else if (root.playback_speed == 2.0) {
                            root.set_playback_speed(0.5);
                        } else {
                            root.set_playback_speed(1.0);
                        }
                    }
                }
            }

            // Center: Formatted Time Readout
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: root.time_readout;
                    color: #f0f6fc;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            // Right: Event Counter & Memory Safety Badge
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Rectangle {
                    height: 20px;
                    border-radius: 4px;
                    background: #1c2128;
                    border-width: 1px;
                    border-color: #388bfd33;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "⚡ \{root.total_spikes_detected} Events";
                            color: #79c0ff;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.status_message;
                    color: #7ee787;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // 2. Timeline Track & Scrubber (Rerun Style)
        Rectangle {
            height: 38px;
            border-radius: 4px;
            background: #0d1117;
            border-width: 1px;
            border-color: #30363d;
            clip: true;

            // Shaded Visible Window Indicator
            Rectangle {
                x: (root.window_start_sec / root.total_duration_sec) * parent.width;
                width: Math.max(8px, (root.visible_window_sec / root.total_duration_sec) * parent.width);
                height: 100%;
                background: #0284c733;
                border-width: 1px;
                border-color: #38bdf888;
            }

            // Draggable Playhead (Vertical Coral/Red Bar)
            Rectangle {
                x: (root.current_time_sec / root.total_duration_sec) * parent.width - 1.5px;
                width: 3px;
                height: 100%;
                background: #f43f5e;

                // Playhead top marker flag
                Rectangle {
                    y: 0px;
                    x: -4px;
                    width: 11px;
                    height: 8px;
                    border-radius: 2px;
                    background: #f43f5e;
                }
            }

            // Timeline Scrubber Interaction
            scrubber_touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        let ratio = Math.clamp(scrubber_touch.mouse_x / parent.width, 0.0, 1.0);
                        root.scrub_to_ratio(ratio);
                    }
                }

                moved => {
                    if (scrubber_touch.pressed) {
                        let ratio = Math.clamp(scrubber_touch.mouse_x / parent.width, 0.0, 1.0);
                        root.scrub_to_ratio(ratio);
                    }
                }
            }
        }

        // 3. Timeline Time Ruler Tick Marks
        HorizontalLayout {
            height: 16px;
            alignment: space-between;

            Text { text: "0.00s"; color: #8b949e; font-size: 10px; }
            Text { text: "\{root.total_duration_sec * 0.25}s"; color: #484f58; font-size: 10px; }
            Text { text: "\{root.total_duration_sec * 0.50}s"; color: #8b949e; font-size: 10px; }
            Text { text: "\{root.total_duration_sec * 0.75}s"; color: #484f58; font-size: 10px; }
            Text { text: "\{root.total_duration_sec}s"; color: #8b949e; font-size: 10px; }
        }
    }
}
