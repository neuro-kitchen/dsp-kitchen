import { IconButton } from "../widgets/icon_button.slint";
import { PillButton } from "../widgets/pill_button.slint";

export component Header inherits Rectangle {
    in property <string> dataset_name: "mearec_32ch_10s.bin";
    in property <int> channel_count: 32;
    in property <float> sample_rate: 32000.0;
    in property <float> visible_window_sec: 0.100;
    in property <float> amplitude_scale: 1.0;
    in property <string> channel_label_range: "Ch 0 - Ch 7 (of 32)";

    callback set_window_duration(float);
    callback zoom_amplitude(float);
    callback prev_channel_page();
    callback next_channel_page();

    height: 52px;
    background: #161b22;

    // Bottom border divider
    Rectangle {
        width: 100%;
        height: 1px;
        y: parent.height - 1px;
        background: #30363d;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        // Left: Brand Badge & Dataset Info Chip
        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: #0284c7;
                    Text {
                        text: "🐊";
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "CROC";
                    color: #38bdf8;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            Rectangle { width: 1px; height: 24px; background: #30363d; y: 14px; }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: root.dataset_name;
                    color: #e6edf3;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 18px;
                    border-radius: 9px;
                    background: #21262d;
                    border-width: 1px;
                    border-color: #30363d;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "\{root.channel_count} Ch @ \{root.sample_rate / 1000.0} kHz";
                            color: #8b949e;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Center: Time Window Zoom Presets
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            Text {
                text: "Window:";
                color: #8b949e;
                font-size: 11px;
                vertical-alignment: center;
            }

            PillButton {
                text: "25ms";
                selected: root.visible_window_sec == 0.025;
                clicked => { root.set_window_duration(0.025); }
            }
            PillButton {
                text: "50ms";
                selected: root.visible_window_sec == 0.050;
                clicked => { root.set_window_duration(0.050); }
            }
            PillButton {
                text: "100ms";
                selected: root.visible_window_sec == 0.100;
                clicked => { root.set_window_duration(0.100); }
            }
            PillButton {
                text: "250ms";
                selected: root.visible_window_sec == 0.250;
                clicked => { root.set_window_duration(0.250); }
            }
            PillButton {
                text: "500ms";
                selected: root.visible_window_sec == 0.500;
                clicked => { root.set_window_duration(0.500); }
            }
            PillButton {
                text: "1.0s";
                selected: root.visible_window_sec == 1.0;
                clicked => { root.set_window_duration(1.0); }
            }
        }

        // Right: Gain Scaling & Channel Pagination
        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                Text { text: "Gain:"; color: #8b949e; font-size: 11px; vertical-alignment: center; }
                IconButton {
                    icon_text: "-";
                    clicked => { root.zoom_amplitude(0.75); }
                }
                Text {
                    text: "\{root.amplitude_scale}x";
                    color: #c9d1d9;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                IconButton {
                    icon_text: "+";
                    clicked => { root.zoom_amplitude(1.33); }
                }
            }

            Rectangle { width: 1px; height: 24px; background: #30363d; y: 14px; }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                IconButton {
                    icon_text: "▲";
                    clicked => { root.prev_channel_page(); }
                }
                Text {
                    text: root.channel_label_range;
                    color: #58a6ff;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                IconButton {
                    icon_text: "▼";
                    clicked => { root.next_channel_page(); }
                }
            }
        }
    }
}
