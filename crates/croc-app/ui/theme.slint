// Design tokens shared by all components (dark theme).
export global Theme {
    // Surfaces
    out property <color> window-bg: #0d1117;
    out property <color> surface: #161b22;
    out property <color> surface-raised: #21262d;
    out property <color> surface-pressed: #2d333b;
    out property <color> plot-bg: #090d13;
    out property <color> border: #30363d;
    out property <color> border-hover: #444c56;

    // Text
    out property <color> text: #e6edf3;
    out property <color> text-strong: #f0f6fc;
    out property <color> text-muted: #8b949e;
    out property <color> text-dim: #6e7681;

    // Accents
    out property <color> accent: #38bdf8;
    out property <color> accent-strong: #0284c7;
    out property <color> accent-soft: #0284c733;
    out property <color> link: #58a6ff;
    out property <color> info: #79c0ff;
    out property <color> playhead: #f43f5e;
    out property <color> loop: #a855f7;
    out property <color> crosshair: #ffffff30;

    // Spacing & radii
    out property <length> pad: 16px;
    out property <length> gap: 8px;
    out property <length> gap-small: 4px;
    out property <length> radius: 4px;
    out property <length> control-height: 28px;

    // Type scale
    out property <length> font-small: 11px;
    out property <length> font-body: 13px;
    out property <length> font-title: 15px;
}

// Seat chrome sizes. Rust computes plot canvases from the same numbers and sets these at
// startup, so the image always maps 1:1 onto the plot area.
export global Metrics {
    in-out property <length> seat-header: 30px;
    in-out property <length> gutter: 64px;
    in-out property <length> axis: 22px;
}
