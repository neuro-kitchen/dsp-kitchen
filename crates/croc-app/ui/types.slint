// Data crossing the Rust ⇄ Slint boundary.

export enum ViewKind { traces, heatmap }

// Where a dragged view lands on a seat: centre joins it as a tab, edges split it.
export enum DropSide { centre, left, right, top, bottom }

export struct LaneLabel {
    label: string,
    color: color,
    // Vertical center as a fraction of the plot height
    y_frac: float,
}

export struct TimeTick {
    // Horizontal position as a fraction of the plot width
    frac: float,
    label: string,
}

export struct TabData {
    view_id: int,
    title: string,
    kind: ViewKind,
}

// One seat of the workspace, already placed by Rust (logical px, workspace-relative),
// with the render state of its active view.
export struct SeatData {
    x: length,
    y: length,
    width: length,
    height: length,
    tabs: [TabData],
    active: int,
    // -1 when the seat is empty
    view_id: int,
    kind: ViewKind,
    focused: bool,
    image: image,
    lanes: [LaneLabel],
    ticks: [TimeTick],
    scale_bar_label: string,
    scale_bar_frac: float,
    hover_readout: string,
    empty_message: string,
}

export struct DividerData {
    index: int,
    columns: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct ChannelRow {
    channel: int,
    label: string,
    color: color,
    checked: bool,
    events: int,
}

// Settings of the focused view for the properties panel.
export struct FocusedView {
    valid: bool,
    view_id: int,
    title: string,
    kind: ViewKind,
    lanes: int,
    lanes_max: int,
    gain_label: string,
    range_label: string,
    selected: int,
}
