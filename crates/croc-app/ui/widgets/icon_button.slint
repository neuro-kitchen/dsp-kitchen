import { Theme } from "../theme.slint";

// Reusable IconButton with dark theme styling
export component IconButton inherits Rectangle {
    in property <string> icon_text: "▶";
    in property <bool> is_active: false;
    in property <color> active_color: Theme.accent;
    callback clicked <=> touch.clicked;

    width: 30px;
    height: Theme.control-height;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-pressed : (touch.has-hover ? Theme.surface-raised : (root.is_active ? #1e293b : Theme.surface));
    border-width: 1px;
    border-color: root.is_active ? root.active_color : (touch.has-hover ? Theme.border-hover : Theme.border);

    Text {
        text: root.icon_text;
        color: root.is_active ? root.active_color : (touch.has-hover ? Theme.text-strong : #c9d1d9);
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}
