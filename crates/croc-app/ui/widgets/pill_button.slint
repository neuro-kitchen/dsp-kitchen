import { Theme } from "../theme.slint";

// Reusable PillButton for presets and toggle options
export component PillButton inherits Rectangle {
    in property <string> text: "100ms";
    in property <bool> selected: false;
    callback clicked <=> touch.clicked;

    height: 24px;
    border-radius: 12px;
    background: root.selected ? Theme.accent-strong : (touch.has-hover ? Theme.surface-raised : Theme.surface);
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.selected ? #ffffff : (touch.has-hover ? Theme.text-strong : Theme.text-muted);
            font-size: Theme.font-small;
            font-weight: root.selected ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}
