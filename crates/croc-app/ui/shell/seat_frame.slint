import { Theme, Metrics } from "theme.slint";
import { DropSide, TabData } from "types.slint";
import { AppLogic } from "app_logic.slint";

// One tab in a seat header: click to show, drag to move the view, × to close.
component SeatTab inherits Rectangle {
    in property <int> module;
    in property <string> title;
    in property <int> view_id;
    in property <bool> active;
    in property <bool> seat_focused;
    callback activate();
    callback close();

    height: Metrics.seat-header;
    width: row.preferred-width;
    background: root.active ? Theme.plot-bg : (tab_touch.has-hover ? Theme.surface-raised : transparent);

    // Accent underline on the active tab of the focused seat
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active && root.seat_focused ? Theme.accent : transparent;
    }

    DragArea {
        data: AppLogic.view_to_transfer(root.module, root.view_id);
        allow-move: true;
        opacity: self.dragging ? 0.5 : 1.0;

        tab_touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.activate(); }
        }

        row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;
            Text {
                text: root.title;
                color: root.active ? Theme.text : Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: root.active ? 600 : 400;
                vertical-alignment: center;
            }
            Rectangle {
                width: 16px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 16px;
                        border-radius: 3px;
                        background: close_touch.has-hover ? Theme.surface-pressed : transparent;
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? Theme.text-strong : Theme.text-dim;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        close_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.close(); }
                        }
                    }
                }
            }
        }
    }
}

// Generic seat of a module workspace: tab strip + the module's content (@children).
// Dropping a dragged view of the same module on an edge splits the seat; on the middle or
// the tab strip it joins as a tab.
export component SeatFrame inherits Rectangle {
    // Module id: views only dock within their own module
    in property <int> module;
    in property <[TabData]> tabs;
    in property <int> active;
    in property <bool> focused;
    // Active view (drop target identity)
    in property <int> view_id;

    callback activate(int);
    callback close(int);
    // (dragged view, side)
    callback dropped(int, DropSide);

    background: Theme.plot-bg;
    clip: true;

    VerticalLayout {
        Rectangle {
            height: Metrics.seat-header;
            background: Theme.surface;

            HorizontalLayout {
                alignment: start;
                for tab[i] in root.tabs: SeatTab {
                    module: root.module;
                    title: tab.title;
                    view_id: tab.view_id;
                    active: i == root.active;
                    seat_focused: root.focused;
                    activate => { root.activate(tab.view_id); }
                    close => { root.close(tab.view_id); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            @children
        }
    }

    // Focus outline (overlay: does not change the content size)
    Rectangle {
        border-width: 1px;
        border-color: root.focused ? #38bdf866 : Theme.border;
        background: transparent;
    }

    // Drop target: side from the pointer, previewed while a view hovers
    landing := DropArea {
        property <DropSide> side: DropSide.centre;

        function side_at(x: length, y: length) -> DropSide {
            // The tab strip and the middle join as a tab; an outer quarter splits
            if (y < Metrics.seat-header) {
                return DropSide.centre;
            }
            let fx = x / root.width;
            let fy = (y - Metrics.seat-header) / Math.max(1px, root.height - Metrics.seat-header);
            let edge = Math.min(Math.min(fx, 1 - fx), Math.min(fy, 1 - fy));
            if (edge > 0.25) {
                return DropSide.centre;
            }
            if (edge == fx) { return DropSide.left; }
            if (edge == 1 - fx) { return DropSide.right; }
            if (edge == fy) { return DropSide.top; }
            return DropSide.bottom;
        }

        can-drop(event) => {
            if (AppLogic.transfer_to_view(root.module, event.data) < 0) {
                return DragAction.none;
            }
            self.side = self.side_at(event.position.x, event.position.y);
            event.proposed-action
        }
        dropped(event) => {
            let view = AppLogic.transfer_to_view(root.module, event.data);
            if (view >= 0) {
                root.dropped(view, self.side_at(event.position.x, event.position.y));
            }
            event.proposed-action
        }
    }

    // Drop preview
    if landing.has-drag: Rectangle {
        x: landing.side == DropSide.right ? root.width / 2 : 0px;
        y: landing.side == DropSide.bottom ? root.height / 2 : 0px;
        width: (landing.side == DropSide.left || landing.side == DropSide.right) ? root.width / 2 : root.width;
        height: (landing.side == DropSide.top || landing.side == DropSide.bottom) ? root.height / 2 : root.height;
        background: #38bdf826;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// Centered hint shown in a seat without content.
export component EmptyHint inherits Rectangle {
    in property <string> text;
    Text {
        text: root.text;
        color: Theme.text-muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}
