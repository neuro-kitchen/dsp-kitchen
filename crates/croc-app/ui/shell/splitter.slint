import { Theme } from "theme.slint";

// Gutter handle between two seats. Invisible until hovered or dragged; reports the drag
// distance since the press in window coordinates (the handle moves while dragged, so a
// local delta would cancel itself out).
export component Splitter inherits Rectangle {
    in property <bool> columns;
    callback pressed();
    callback moved(delta: length);

    property <length> origin;

    Rectangle {
        x: root.columns ? (parent.width - self.width) / 2 : 6px;
        y: root.columns ? 6px : (parent.height - self.height) / 2;
        width: root.columns ? 2px : Math.max(0px, parent.width - 12px);
        height: root.columns ? Math.max(0px, parent.height - 12px) : 2px;
        border-radius: 1px;
        background: Theme.accent;
        opacity: (touch.has-hover || touch.pressed) ? 1.0 : 0.0;
        animate opacity { duration: 100ms; }
    }

    touch := TouchArea {
        x: root.columns ? -2px : 0px;
        y: root.columns ? 0px : -2px;
        width: root.width + (root.columns ? 4px : 0px);
        height: root.height + (root.columns ? 0px : 4px);
        mouse-cursor: root.columns ? MouseCursor.ew-resize : MouseCursor.ns-resize;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.origin = root.columns
                    ? self.absolute-position.x + self.mouse-x
                    : self.absolute-position.y + self.mouse-y;
                root.pressed();
            }
        }
        moved => {
            root.moved(root.columns
                ? self.absolute-position.x + self.mouse-x - root.origin
                : self.absolute-position.y + self.mouse-y - root.origin);
        }
    }
}
