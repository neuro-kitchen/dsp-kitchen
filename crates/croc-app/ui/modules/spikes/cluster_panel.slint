import { ListView } from "std-widgets.slint";
import { Theme } from "../../shell/theme.slint";
import { AppState } from "../../shell/app_logic.slint";
import { SpikeState, SpikeLogic } from "spike_logic.slint";

component Cell inherits Text {
    color: Theme.text;
    font-size: Theme.font-small;
    vertical-alignment: center;
    horizontal-alignment: right;
}

component HeaderCell inherits Text {
    color: Theme.text-muted;
    font-size: 10px;
    font-weight: 700;
    vertical-alignment: center;
    horizontal-alignment: right;
}

// Column widths shared by header and rows
component Columns inherits HorizontalLayout {
    padding-left: 8px;
    padding-right: 8px;
    spacing: 4px;
}

// Fixed left panel of the Spike module (phy's cluster view): click selects, Ctrl/Shift-click
// adds to the selection. The first selected cluster is blue, the second red, … in every widget.
export component ClusterPanel inherits Rectangle {
    background: Theme.plot-bg;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        Rectangle {
            height: 30px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 10px;
                Text {
                    text: "CLUSTERS · \{SpikeState.cluster_rows.length}";
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 24px;
            background: Theme.surface;
            Columns {
                HeaderCell { text: "#"; width: 24px; horizontal-alignment: left; }
                HeaderCell { text: "ch"; width: 22px; }
                HeaderCell { text: "n"; width: 34px; }
                HeaderCell { text: "µV"; width: 36px; }
                HeaderCell { text: "Hz"; width: 32px; }
                HeaderCell { text: "SNR"; width: 30px; }
                HeaderCell { text: "ISI %"; horizontal-stretch: 1; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }

        if SpikeState.cluster_rows.length == 0: Text {
            text: AppState.sort_running ? "Sorting…" : "No clusters — run sorting (Ctrl+R)";
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        ListView {
            vertical-stretch: 1;
            for row in SpikeState.cluster_rows: Rectangle {
                height: 24px;
                background: row.selected ? #38bdf81f : (touch.has-hover ? Theme.surface-raised : transparent);

                // Selection color swatch
                Rectangle {
                    x: 0px;
                    width: 4px;
                    background: row.color;
                }

                Columns {
                    Cell { text: row.id; width: 24px; horizontal-alignment: left; color: row.selected ? row.color : Theme.text; font-weight: row.selected ? 700 : 400; }
                    Cell { text: row.channel; width: 22px; }
                    Cell { text: row.spikes; width: 34px; }
                    Cell { text: row.amplitude; width: 36px; }
                    Cell { text: row.rate; width: 32px; }
                    Cell { text: row.snr; width: 30px; }
                    Cell { text: row.isi; horizontal-stretch: 1; color: row.isi_bad ? #f85149 : Theme.text; }
                }

                touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            SpikeLogic.select_cluster(row.id, event.modifiers.control || event.modifiers.shift);
                        }
                    }
                }
            }
        }
    }
}
