import { Theme, Metrics } from "../../shell/theme.slint";
import { AxisLabel } from "spike_types.slint";

// Plot of one spike view: value labels in the gutter, raster image, x-axis labels, note.
// Its plot area must be exactly (width - Metrics.gutter) × (height - Metrics.axis): Rust
// renders the raster at that size.
export component SpikePlotView inherits Rectangle {
    in property <image> image;
    in property <[AxisLabel]> y_labels;
    in property <[AxisLabel]> x_labels;
    in property <string> note;
    callback pressed();

    background: Theme.plot-bg;

    HorizontalLayout {
        gutter := Rectangle {
            width: Metrics.gutter;
            clip: true;
            for l in root.y_labels: Text {
                x: gutter.width - self.width - 8px;
                y: l.frac * plot.height - self.height / 2;
                text: l.label;
                color: Theme.text-muted;
                font-size: 10px;
            }
        }

        VerticalLayout {
            plot := Rectangle {
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.image;
                    image-fit: fill;
                }

                if root.note != "": Rectangle {
                    x: plot.width - self.width - 8px;
                    y: plot.height - self.height - 6px;
                    width: note_text.preferred-width + 8px;
                    height: note_text.preferred-height + 2px;
                    border-radius: 3px;
                    background: #090d13cc;
                    note_text := Text {
                        text: root.note;
                        color: Theme.text;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.pressed();
                        }
                    }
                }
            }

            axis := Rectangle {
                height: Metrics.axis;
                clip: true;
                Rectangle { y: 0px; height: 1px; background: Theme.border; }
                for l in root.x_labels: Rectangle {
                    x: l.frac * axis.width;
                    y: 0px;
                    width: 1px;
                    height: 4px;
                    background: Theme.border-hover;
                }
                for l in root.x_labels: Text {
                    x: Math.clamp(l.frac * axis.width - self.width / 2, 0px, axis.width - self.width);
                    y: 6px;
                    text: l.label;
                    color: Theme.text-muted;
                    font-size: 10px;
                }
            }
        }
    }
}
