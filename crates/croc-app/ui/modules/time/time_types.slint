// Types of the Time module.

import { TabData } from "../../shell/types.slint";

export enum TimeViewKind { traces, heatmap }

export struct LaneLabel {
    label: string,
    color: color,
    // Vertical center as a fraction of the plot height
    y_frac: float,
}

export struct TimeTick {
    // Horizontal position as a fraction of the plot width
    frac: float,
    label: string,
}

// One seat of the time workspace, placed by Rust (logical px), with its active view's state.
export struct TimeSeat {
    x: length,
    y: length,
    width: length,
    height: length,
    tabs: [TabData],
    active: int,
    // -1 when the seat is empty
    view_id: int,
    kind: TimeViewKind,
    focused: bool,
    image: image,
    lanes: [LaneLabel],
    ticks: [TimeTick],
    scale_bar_label: string,
    scale_bar_frac: float,
    hover_readout: string,
    empty_message: string,
}

export struct ChannelRow {
    channel: int,
    label: string,
    color: color,
    checked: bool,
    events: int,
}

// Settings of the focused time view.
export struct TimeFocused {
    valid: bool,
    view_id: int,
    title: string,
    kind: TimeViewKind,
    // Index into TimeViewKind order (type combo box)
    kind_index: int,
    lanes: int,
    lanes_max: int,
    gain_label: string,
    range_label: string,
    selected: int,
}
