import { Theme } from "../../shell/theme.slint";
import { IconButton } from "../../shell/widgets/icon_button.slint";
import { PillButton } from "../../shell/widgets/pill_button.slint";

export component TimelinePanel inherits Rectangle {
    in property <float> total_duration_sec: 1.0;
    in property <float> current_time_sec: 0.0;
    in property <float> visible_window_sec: 0.100;
    in property <float> window_start_sec: 0.0;
    in property <bool> is_playing: false;
    in property <bool> loop_playback: true;
    in property <float> playback_speed: 1.0;
    in property <string> time_readout;
    in property <int> total_spikes_detected: 0;
    in property <string> status_message;
    in property <image> overview_image;
    in property <int> channel_count: 0;
    in property <float> sample_rate: 0;

    callback toggle_play_pause();
    callback step_forward();
    callback step_backward();
    callback jump_to_start();
    callback jump_to_end();
    callback toggle_loop();
    callback set_playback_speed(float);
    callback scrub_to_ratio(float);
    // Drag of the visible-window box, as a fraction of the whole recording
    callback pan_overview(float);
    // New window edges as ratios of the whole recording
    callback set_window_edges(float, float);
    callback overview_resized(length, length);

    height: 130px;
    background: Theme.surface;

    // Top border divider
    Rectangle {
        width: 100%;
        height: 1px;
        y: 0px;
        background: Theme.border;
    }

    VerticalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        padding-top: Theme.gap;
        padding-bottom: Theme.gap;
        spacing: 6px;

        // 1. Playback Control Bar
        HorizontalLayout {
            height: 32px;

            // Transport Buttons
            HorizontalLayout {
                spacing: Theme.gap-small;
                horizontal-stretch: 1;
                alignment: start;

                IconButton {
                    icon_text: "⏮";
                    clicked => { root.jump_to_start(); }
                }
                IconButton {
                    icon_text: "◀";
                    clicked => { root.step_backward(); }
                }
                IconButton {
                    icon_text: root.is_playing ? "⏸" : "▶";
                    is_active: root.is_playing;
                    clicked => { root.toggle_play_pause(); }
                }
                IconButton {
                    icon_text: "▶";
                    clicked => { root.step_forward(); }
                }
                IconButton {
                    icon_text: "⏭";
                    clicked => { root.jump_to_end(); }
                }
                IconButton {
                    icon_text: "🔁";
                    is_active: root.loop_playback;
                    active_color: Theme.loop;
                    clicked => { root.toggle_loop(); }
                }
                VerticalLayout {
                    alignment: center;
                    PillButton {
                        text: "\{root.playback_speed}×";
                        clicked => {
                            if (root.playback_speed == 1.0) {
                                root.set_playback_speed(2.0);
                            } else if (root.playback_speed == 2.0) {
                                root.set_playback_speed(0.5);
                            } else {
                                root.set_playback_speed(1.0);
                            }
                        }
                    }
                }
            }

            // Center: Formatted Time Readout
            Text {
                text: root.time_readout;
                color: Theme.text-strong;
                font-size: Theme.font-body;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Right: Event counter & render status
            HorizontalLayout {
                spacing: Theme.gap;
                horizontal-stretch: 1;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        border-radius: Theme.radius;
                        background: #1c2128;
                        border-width: 1px;
                        border-color: #388bfd33;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "⚡ \{root.total_spikes_detected} events";
                                color: Theme.info;
                                font-size: Theme.font-small;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "\{root.channel_count} ch · \{root.sample_rate / 1000.0} kHz";
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                Text {
                    text: root.status_message;
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }

        // 2. Overview track: spike density, visible window, playhead (Rerun style)
        track := Rectangle {
            height: 38px;
            border-radius: Theme.radius;
            background: Theme.window-bg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.overview_image;
                image-fit: fill;
            }

            // Click / drag anywhere else to scrub the playhead
            scrubber_touch := TouchArea {
                mouse-cursor: pointer;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.scrub_to_ratio(Math.clamp(self.mouse_x / track.width, 0.0, 1.0));
                    }
                }

                moved => {
                    if (self.pressed) {
                        root.scrub_to_ratio(Math.clamp(self.mouse_x / track.width, 0.0, 1.0));
                    }
                }
            }

            // Visible window box: drag to pan, drag edges to resize
            window_box := Rectangle {
                x: (root.window_start_sec / root.total_duration_sec) * track.width;
                width: Math.max(8px, (root.visible_window_sec / root.total_duration_sec) * track.width);
                height: 100%;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: #38bdf888;

                box_touch := TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    property <length> last_x;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.last_x = self.mouse_x;
                        }
                    }
                    // The box moves under the cursor, so the local delta is measured against
                    // the grab point rather than the previous event
                    moved => {
                        if (self.pressed) {
                            root.pan_overview((self.mouse_x - self.last_x) / track.width);
                        }
                    }
                }

                // Left / right resize handles
                left_handle := TouchArea {
                    x: 0px;
                    width: 6px;
                    mouse-cursor: MouseCursor.ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.set_window_edges(
                                Math.clamp((window_box.x + self.mouse_x) / track.width, 0.0, 1.0),
                                (window_box.x + window_box.width) / track.width);
                        }
                    }
                }
                right_handle := TouchArea {
                    x: window_box.width - 6px;
                    width: 6px;
                    mouse-cursor: MouseCursor.ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.set_window_edges(
                                window_box.x / track.width,
                                Math.clamp((window_box.x + self.x + self.mouse_x) / track.width, 0.0, 1.0));
                        }
                    }
                }
            }

            // Playhead (visual only)
            Rectangle {
                x: (root.current_time_sec / root.total_duration_sec) * track.width - 1.5px;
                width: 3px;
                height: 100%;
                background: Theme.playhead;

                Rectangle {
                    y: 0px;
                    x: -4px;
                    width: 11px;
                    height: 8px;
                    border-radius: 2px;
                    background: Theme.playhead;
                }
            }

            init => {
                root.overview_resized(self.width, self.height);
            }
            changed width => {
                root.overview_resized(self.width, self.height);
            }
        }

        // 3. Ruler
        HorizontalLayout {
            height: 16px;
            alignment: space-between;

            for q in [0.0, 0.25, 0.5, 0.75, 1.0]: Text {
                text: "\{Math.round(root.total_duration_sec * q * 100) / 100}s";
                color: Theme.text-muted;
                font-size: 10px;
            }
        }
    }
}
